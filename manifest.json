{
  "manifest_version": 3,
  "name": "equery",
  "version": "0",
  "description": "Search for horse name",
  "icons": {
    "128": "128.png"
  },
  "omnibox": {
    "keyword": "eq"
  },
  "permissions": [
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.equibase.com/favicon.ico*"],
      "js": ["equibase.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
